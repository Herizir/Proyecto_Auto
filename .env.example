# Copia este archivo como .env si necesitas cambiar la conexión.
# Sin .env se usa: servidor localhost, base MOTORHAUS y autenticación de Windows.

MOTORHAUS_DB_SERVIDOR=localhost
MOTORHAUS_DB_NOMBRE=MOTORHAUS

# Déjalos vacíos para usar la autenticación de Windows.
MOTORHAUS_DB_USUARIO=
MOTORHAUS_DB_CLAVE=

# Opcional: fuerza un driver ODBC concreto (por defecto se detecta solo).
# MOTORHAUS_DB_DRIVER=ODBC Driver 18 for SQL Server

MOTORHAUS_WEB_PUERTO=5000

# Estudio IA (Ollama local)
MOTORHAUS_IA_URL=http://127.0.0.1:11434
MOTORHAUS_IA_MODELO=llama3.2:3b
